# The public build repo (an export of the private engine; see README.md). Raw downloads, caches and logs
# never enter git: they live in the Actions cache or on the runner only.
.env
data/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
logs/
scripts/*.log
.DS_Store
node_modules/

# Package data the code reads at run time (the generic data/ rule above must not catch it).
!oddsmarkets/sports/world_cup/data/
!oddsmarkets/football/competitions/liga/data/
!oddsmarkets/football/competitions/league/data/
!oddsmarkets/football/analytics/data/
!oddsmarkets/football/analytics/data/**

# Football: the raw Sofascore stores are read from a private repository at build time and never committed here;
# everything under docs/site/data/ is build output.
!docs/site/data/
docs/site/data/**
docs/liga/

# The other sites: their committed inputs are tracked; everything else under docs/<site>/data/ is build output.
!docs/paddock/data/
docs/paddock/data/**
!docs/paddock/data/*/
!docs/paddock/data/*/store.json
!docs/paddock/data/calibration.json
!docs/paddock/data/*/sessions/
!docs/paddock/data/*/sessions/**
!docs/paddock/data/*/telemetry/
!docs/paddock/data/*/telemetry/**

!docs/hardwood/data/
docs/hardwood/data/**
!docs/hardwood/data/*/
!docs/hardwood/data/*/*/
!docs/hardwood/data/*/*/store.json
!docs/hardwood/data/*/*/recon.json
!docs/hardwood/data/*/*/shots.json.gz
!docs/hardwood/data/*/*/stints.json.gz
!docs/hardwood/data/*/calibration.json
!docs/hardwood/data/*/bio.json
!docs/hardwood/data/*/fantasy_backtest.json

!docs/ace/data/
docs/ace/data/**
!docs/ace/data/*/
!docs/ace/data/*/*/
!docs/ace/data/*/*/store.json
!docs/ace/data/*/registry.json
!docs/ace/data/*/style.json
!docs/ace/data/*/calibration.json
!docs/ace/data/*/bio.json

!docs/bullpen/data/
docs/bullpen/data/**
!docs/bullpen/data/*/
!docs/bullpen/data/*/*/
!docs/bullpen/data/*/*/store.json
!docs/bullpen/data/people.json
!docs/bullpen/data/*/calibration.json
docs/bullpen/data/npb/

!docs/gridiron/data/
docs/gridiron/data/**
!docs/gridiron/data/*/
!docs/gridiron/data/*/store.json
!docs/gridiron/data/calibration.json

!docs/rink/data/
docs/rink/data/**
!docs/rink/data/*/
!docs/rink/data/*/store.json
!docs/rink/data/calibration.json
